{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.9.0",
        "--executablePath",
        "/opt/pw-browsers/chromium",
        "--headless",
        "--isolated",
        "--no-pageIdRouting",
        "--usageStatistics",
        "false",
        "--chromeArg=--no-sandbox"
      ]
    }
  }
}
