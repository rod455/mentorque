<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Mesma regra do backup_rules.xml: nada de sessão da WebView
     saindo em backup na nuvem ou em transferência entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
