<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. Sem esta permissão o iOS recusa a folha nativa com
	     erro 1000 (ASAuthorizationError.unknown) e o botão simplesmente não
	     abre nada. É o que faz o login da Apple acontecer DENTRO do app.

	     Do outro lado, a capacidade "Sign In with Apple" precisa estar ligada
	     no App ID (developer.apple.com → Identifiers → mentorque.app), senão o
	     perfil de assinatura não é gerado e o build falha na hora de assinar. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push (APNs). Entrou em 28/08/2026, DEPOIS de o dono ligar a capacidade
	     Push Notifications no App ID e regenerar o perfil de assinatura no
	     Codemagic; nesta ordem, porque entitlement sem capacidade no perfil
	     derruba o build na hora de assinar. O registro do aparelho e o envio
	     estão em lib/app/push.ts e docs/push.md. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
