{
  "name": "mentorque-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync:android": "cap sync android",
    "android:studio": "npm run build:native && cap sync android",
    "sync:ios": "node scripts/ios-google-scheme.mjs && cap sync ios",
    "open:android": "cap open android",
    "build:native": "node scripts/build-native.mjs",
    "verifica:quiz": "npm run conferir:regras",
    "quiz:pdf": "node --experimental-strip-types scripts/quiz-pdf.ts",
    "conferir": "npm run conferir:tipos && npm run conferir:estilo && npm run conferir:regras && npm run conferir:revisoes && npm run conferir:navegacao && npm run conferir:frescor && npm run conferir:versoes && npm run conferir:travessao && npm run conferir:identidade && npm run conferir:catalogo",
    "conferir:tipos": "tsc --noEmit",
    "conferir:estilo": "next lint",
    "conferir:regras": "node --experimental-strip-types scripts/verifica-quiz.ts",
    "conferir:versoes": "node scripts/verifica-versoes.mjs",
    "conferir:travessao": "node scripts/verifica-travessao.mjs",
    "conferir:identidade": "node --experimental-strip-types scripts/verifica-identidade.ts",
    "conferir:catalogo": "node --experimental-strip-types scripts/verifica-catalogo.ts",
    "conferir:revisoes": "node --experimental-strip-types scripts/verifica-revisoes.ts",
    "conferir:navegacao": "node --experimental-strip-types scripts/verifica-navegacao.ts",
    "conferir:frescor": "node --experimental-strip-types scripts/verifica-frescor.ts",
    "conferir:navegador": "node scripts/navegador/todos.mjs",
    "conferir:tudo": "npm run conferir && npm run build && npm run conferir:navegador"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-social-login": "^8.3.40",
    "@revenuecat/purchases-capacitor": "^13.3.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/supabase-js": "^2.45.4",
    "appsflyer-capacitor-plugin": "^6.18.0",
    "framer-motion": "^11.3.24",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
