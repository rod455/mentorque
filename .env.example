# ── Supabase ────────────────────────────────────────────────────────────────
# Public by design (shipped in the client bundle). RLS governs what they can do.
NEXT_PUBLIC_SUPABASE_URL=https://ajaxhsvjvmqtiyzelgrd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tiPExxVzcmHVYlxVEEUzyA_3Bs7G_kC

# Server-only. Used by the Biela RAG retrieval to read the manuals (bypasses
# RLS). NEVER expose this to the client — no NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── AI (Biela chat) ─────────────────────────────────────────────────────────
# When set, /api/biela answers with Claude; otherwise it uses "basic" mode.
ANTHROPIC_API_KEY=sk-ant-xxx
BIELA_MODEL=claude-sonnet-5

# Embeddings provider for the manual RAG (text-embedding-3-small, 1536 dims).
# When set together with SUPABASE_SERVICE_ROLE_KEY, Biela grounds answers in the
# uploaded manuals. Without it, Biela still answers, just without manual context.
OPENAI_API_KEY=sk-xxx

# ── Waitlist welcome email (Resend) ─────────────────────────────────────────
# When set, /api/waitlist sends a welcome email on new signups. Verify the
# domain mentorque.com.br in Resend first (SPF/DKIM DNS records).
RESEND_API_KEY=re_xxx
WAITLIST_FROM=Mentorque <contato@mentorque.com.br>
# In-app feedback (Dúvida/Sugestão/Bug) email. FROM must be a verified domain;
# TO is your team inbox (defaults to contato@mentorque.com.br).
FEEDBACK_FROM=Mentorque <contato@mentorque.com.br>
FEEDBACK_TO=contato@mentorque.com.br

# Endereço canônico do site. Serve para as imagens absolutas de OG/Twitter E,
# no app das lojas, para TODO fetch de /api — o app é empacotado e não tem
# servidor próprio, então precisa saber de onde vêm Biela, FIPE e revisões.
# Apontar para o lugar errado aqui gera um app que abre e não responde nada.
# COM www: o domínio sem www responde 308 apontando para ele, e no app um
# redirecionamento que troca de origem derruba o fetch com "Load failed".
NEXT_PUBLIC_SITE_URL=https://www.mentorque.com.br

# ── App das lojas (npm run build:native) ────────────────────────────────────
# Estas quatro são EMBUTIDAS no pacote que vai dentro do binário:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY  (login e banco)
#   NEXT_PUBLIC_SITE_URL                                     (rotas /api)
#   NEXT_PUBLIC_REVENUECAT_IOS_KEY                           (compra da Apple)
#
# Só o iPhone vende assinatura: no Android o app é "modo leitor" (a política do
# Play Billing proíbe cobrar por fora) e esta chave fica sem uso.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx

# Client ID do Google para o login nativo no iPhone. Não precisa definir: o
# valor de produção está fixo em lib/app/socialLogin.ts (client id é público).
# Só use para apontar para outro projeto do Google Cloud.
# NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com

# ── Interruptores que ficam DESLIGADOS por padrão ───────────────────────────
# Os dois valem só para o app das lojas: entram embutidos no binário, então
# mudar a variável sem gerar build novo não muda nada no aparelho de ninguém.

# Anúncios (AdMob, só Android). Desligado por decisão do dono: o AdMob está
# todo configurado e conferido, mas enquanto o app é novo e o foco é conversão
# para Premium, anúncio atrapalha a primeira impressão. Com isto desligado não
# há SDK, nem pedido de consentimento, nem anúncio interno.
# NEXT_PUBLIC_ADS=1

# "Entrar com a Apple" fora do iPhone. Desligado porque o fluxo web da Apple
# exige um Services ID próprio (domínio verificado + URL de retorno do
# Supabase) que ainda não existe. Sem ele a Apple recusa na tela dela e o
# usuário só vê erro. No iPhone o login é nativo e funciona sem isto.
# NEXT_PUBLIC_APPLE_WEB=1
