# ── Supabase ────────────────────────────────────────────────────────────────
# Public by design (shipped in the client bundle). RLS governs what they can do.
NEXT_PUBLIC_SUPABASE_URL=https://ajaxhsvjvmqtiyzelgrd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tiPExxVzcmHVYlxVEEUzyA_3Bs7G_kC

# Server-only. Used by the Biela RAG retrieval to read the manuals (bypasses
# RLS). NEVER expose this to the client — no NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── AI (Biela chat) ─────────────────────────────────────────────────────────
# When set, /api/biela answers with Claude; otherwise it uses "basic" mode.
ANTHROPIC_API_KEY=sk-ant-xxx
BIELA_MODEL=claude-sonnet-5

# Embeddings provider for the manual RAG (text-embedding-3-small, 1536 dims).
# When set together with SUPABASE_SERVICE_ROLE_KEY, Biela grounds answers in the
# uploaded manuals. Without it, Biela still answers, just without manual context.
OPENAI_API_KEY=sk-xxx

# Canonical site URL (used for OG/Twitter absolute image URLs).
NEXT_PUBLIC_SITE_URL=https://mentorque.app
